{
  "name": "@xzycd/guestlist",
  "version": "0.1.0",
  "description": "Replay captured web requests across sessions and inspect access-control differences.",
  "type": "module",
  "bin": {
    "guestlist": "dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "demo": "tsx src/cli.tsx demo --plain --no-save",
    "dev": "tsx src/cli.tsx",
    "lint": "eslint .",
    "prepare": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzycd/guestlist.git"
  },
  "bugs": {
    "url": "https://github.com/xzycd/guestlist/issues"
  },
  "homepage": "https://github.com/xzycd/guestlist#readme",
  "keywords": [
    "authorization",
    "cli",
    "har",
    "pentesting",
    "security-testing"
  ],
  "license": "MIT",
  "author": "Audangas",
  "dependencies": {
    "commander": "^15.0.0",
    "ink": "^7.1.1",
    "react": "^19.2.8",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "eslint": "^10.8.0",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
