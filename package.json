{
  "name": "@xzycd/gatecrash",
  "version": "0.6.0",
  "description": "Replay the same web request across sessions to map authorization boundaries.",
  "type": "module",
  "bin": {
    "gatecrash": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "npm-shrinkwrap.json",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SECURITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "demo": "tsx src/cli.ts demo --plain --no-save",
    "dev": "tsx src/cli.ts",
    "lint": "eslint .",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm run release:verify",
    "release:verify": "node scripts/verify-release.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=22.12"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xzycd/gatecrash.git"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org/"
  },
  "bugs": {
    "url": "https://github.com/xzycd/gatecrash/issues"
  },
  "homepage": "https://github.com/xzycd/gatecrash#readme",
  "keywords": [
    "authorization",
    "access-control",
    "bola",
    "cli",
    "har",
    "idor",
    "pentesting",
    "security-testing"
  ],
  "license": "MIT",
  "author": "Audangas",
  "dependencies": {
    "commander": "^15.0.0",
    "parse5": "^8.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
